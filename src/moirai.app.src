{application, moirai, [
    {description, "Erlang/OTP agent harness built from erl_openrouter, erl_mcp, klotho, and magicbeam"},
    {vsn, "0.1.1"},
    {registered, []},
    {mod, {moirai_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        erl_openrouter,
        erl_mcp,
        klotho,
        magicbeam
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/otakup0pe/moirai"}]}
]}.
