{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% All deps must be DECLARED here even when overridden by _checkouts
%% during dev. rebar3's _checkouts mechanism replaces a declared dep
%% by name -- without the declaration, the symlink is invisible to
%% the dep graph and the app does not get added to the code path.
{deps, [
    {erl_openrouter, {git, "https://github.com/otakup0pe/erl_openrouter.git", {tag, "0.5.1"}}},
    {erl_mcp, {git, "https://github.com/otakup0pe/erl_mcp.git", {tag, "0.2.1"}}},
    {klotho, {git, "https://github.com/otakup0pe/klotho.git", {tag, "0.1.1"}}},
    {magicbeam, {git, "https://github.com/otakup0pe/magicbeam.git", {tag, "0.3.0"}}}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {cover_export_enabled, true},
        {cover_spec, "cover.spec"}
    ]}
]}.

{ct_opts, [{dir, "test"}]}.

{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unmatched_returns
    ]},
    {plt_extra_apps, [erl_openrouter, erl_mcp, klotho, magicbeam]}
]}.

{shell, [{apps, [moirai]}]}.
