# -*-Shell-script-*-
# shellcheck shell=bash

OPENROUTER_API_KEY="$(vault kv get  --field emacs_openrouter_token secret/yopo/dotfiles/emacs 2> /dev/null || true)"
if [ -z "$OPENROUTER_API_KEY" ] ; then
    log_error "unable to load openrouter key from vault"
else
    log_status "loaded openrouter key from vault"
    export OPENROUTER_API_KEY
fi
