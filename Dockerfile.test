FROM erlang:27.3.4.9-slim@sha256:a8403c4e5ec42d6b48fe023ae1afd4e0fcfcb7272a559a6c5aa69d2f9d05ff12

RUN apt-get update \
    && apt-get install -y make git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG REBAR3_VERSION=3.28.0
ARG REBAR3_SHA256=5a28b1cca082d3b023ec0f5df9d9f9d52557036c6f2a21c1ffa11b93a984dd42
RUN curl -fsSL https://github.com/erlang/rebar3/releases/download/${REBAR3_VERSION}/rebar3 \
    -o /usr/local/bin/rebar3 \
    && echo "${REBAR3_SHA256}  /usr/local/bin/rebar3" | sha256sum -c - \
    && chmod +x /usr/local/bin/rebar3 \
    && rebar3 version

# Bind-mounted source files must remain writable by the invoking user.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if ! getent group ${HOST_GID} >/dev/null; then \
        groupadd -g ${HOST_GID} build; \
    fi \
    && if ! getent passwd ${HOST_UID} >/dev/null; then \
        useradd -u ${HOST_UID} -g ${HOST_GID} -m -s /bin/sh build; \
    fi \
    && install -d -o ${HOST_UID} -g ${HOST_GID} /app /app/_build /cache

ENV REBAR_CACHE_DIR=/cache

USER ${HOST_UID}:${HOST_GID}

CMD ["make", "local-test"]
